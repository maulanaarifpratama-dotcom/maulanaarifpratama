---
const links = [
  ["/#results", "Results"],
  ["/#work", "Work"],
  ["/#evidence", "Evidence"],
  ["/#experience", "Experience"],
  ["/cv", "CV"],
];
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Maulana Arif Pratama, home">Maulana<span>.</span></a>
    <nav class="nav-links" aria-label="Main">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="btn nav-cta" href="/#contact">Let&rsquo;s talk</a>
    <details class="menu" id="menu">
      <summary aria-label="Menu"><span class="burger"></span></summary>
      <div class="menu-panel">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a class="btn btn-primary" href="/#contact">Let&rsquo;s talk</a>
      </div>
    </details>
  </div>
</header>
<script>
  const menu = document.getElementById("menu") as HTMLDetailsElement | null;
  if (menu) {
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) menu.open = false;
    });
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        (menu.querySelector("summary") as HTMLElement)?.focus();
      }
    });
  }
</script>

<script>
  // Scroll-spy: mark the nav link of the section currently in view.
  const ids = ["results", "work", "evidence", "recognition", "experience", "contact"];
  const map: Record<string, string> = { recognition: "evidence" };
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav-links a, .menu-panel a")];
  const els = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (els.length && "IntersectionObserver" in window) {
    const set = (id: string) =>
      links.forEach((a) => {
        const on = a.getAttribute("href") === `/#${map[id] ?? id}`;
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && set(e.target.id)),
      { rootMargin: "-45% 0px -50% 0px" },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
